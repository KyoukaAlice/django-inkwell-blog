# 复制这个文件为 .env 并填入你自己的值。.env 不会被提交到 Git。
#
# 说明：不填也能跑 —— 用 SQLite 时（start.bat sqlite / DB_ENGINE=sqlite）完全不需要这些；
# 用 MySQL 时至少要把 DB_PASSWORD 填上。

# ---- 数据库（MySQL 模式才需要）----
DB_NAME=myblog_db
DB_USER=root
DB_PASSWORD=在这里填你的 MySQL 密码
DB_HOST=localhost
DB_PORT=3306

# ---- Django ----
# 部署到公网时请换成一串自己的随机字符（至少 50 位）
# DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# 想在本机看到详细报错页就设成 1
# DJANGO_DEBUG=1
