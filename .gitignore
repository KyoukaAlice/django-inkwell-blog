# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- virtual environment ----
.venv/
venv/
env/

# ---- secrets: never commit these ----
.env
.env.local

# ---- Django runtime ----
db.sqlite3
db.sqlite3-journal
*.log
staticfiles/

# ---- user uploads (the runtime upload folders only) ----
# 注意不能整体忽略 media/：快照的图片资源也在 media/ 下，需要提交。
/media/avatars/
/media/comments/
/media/covers/

# ---- static snapshot, generated by "manage.py build_snapshot" ----
# 快照生成在仓库根目录，这样 GitHub Pages 用默认的「main 分支 + 根目录」
# 就能直接生效，不需要改任何仓库设置。
#
# 生成的 HTML 对项目本身没用（只是给 Pages 看的），所以本地忽略掉，
# 保持 git status 干净 —— 否则每次构建都会冒出 39 个改动文件。
#
# ⚠️ 但 GitHub Pages 是直接从这个分支发布这些文件的，所以必须强制提交（!）。
# 想让它们在工作区里也可见 / 可 diff，把下面这段注释掉即可。
/index.html
/index-generated.html
/index-logged-in.html
/index-sort-hot.html
/index-sort-views.html
/404.html
/about.html
/admin.html
/bookmarks.html
/login.html
/notifications.html
/post-create.html
/profile.html
/profile-drafts.html
/profile-edit.html
/register.html
/search.html
/tag-django.html
/tag-markdown.html
/tag-mysql.html
/tag-python.html
/tag-tag-046a899ee7.html
/tag-tag-60eec86da0.html
/tag-tag-9abfe4a039.html
/tag-tag-a42e710340.html
/tags.html
/u-admin.html
/u-alice.html
/u-bob.html
/post/
/docs/
.snapshot-manifest.json

# 上面这些是给 Pages 用的，必须留在版本库里
!/index.html
!/index-generated.html
!/index-logged-in.html
!/index-sort-hot.html
!/index-sort-views.html
!/404.html
!/about.html
!/admin.html
!/bookmarks.html
!/login.html
!/notifications.html
!/post-create.html
!/profile.html
!/profile-drafts.html
!/profile-edit.html
!/register.html
!/search.html
!/tag-*.html
!/tags.html
!/u-*.html
!/post/
!/post/**

# 快照的样式与脚本（同时也是项目自己的源文件，必须提交）
!/static/
!/static/**

# ---- editors / OS ----
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini
