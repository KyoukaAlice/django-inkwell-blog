# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- virtual environment ----
.venv/
venv/
env/

# ---- secrets: never commit these ----
.env
.env.local

# ---- Django runtime ----
db.sqlite3
db.sqlite3-journal
*.log
staticfiles/

# ---- user uploads (runtime only) ----
# 不能整体忽略 media/：docs/media 是快照的一部分，需要提交。
/media/avatars/
/media/comments/
/media/covers/

# ---- 静态快照（GitHub Pages 从 docs/ 发布）----
# 生成：python manage.py build_snapshot
#
# 快照只放在 docs/ 一个目录里，仓库根目录保持干净 ——
# 39 个生成出来的 HTML 不会和 manage.py、README.md 混在一起。
#
# 这里先忽略一批「构建产物」的常见位置，再用 ! 把 docs/ 放回来，
# 这样万一你临时用了 -o . 输出到根目录，也不会把根目录搞乱。
/index.html
/index-*.html
/404.html
/about.html
/admin.html
/bookmarks.html
/login.html
/notifications.html
/post-create.html
/profile.html
/profile-drafts.html
/profile-edit.html
/register.html
/search.html
/tag-*.html
/tags.html
/u-*.html
/post/
/_site/
.snapshot-manifest.json

# docs/ 是 Pages 的发布目录，必须留在版本库里
!/docs/
!/docs/**

# ---- 项目自己的静态资源（同时也是快照的样式来源）----
# 必须提交，否则本地跑起来没样式、docs/ 也复制不到东西
!/static/
!/static/**

# ---- editors / OS ----
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini
